// billing.qwe: a service. Other programs call its server fns.
db.open("billing.db")
db.exec("create table if not exists invoices (id integer primary key, name text not null, cents int not null)")

let served = 0                              // this process's own count
let delay = int(env("BILLING_DELAY", "0"))  // to play a slow server

server fn invoice(name: str, cents: int) -> map ! str with db, time {
    if trim(name) == "" { return err("An invoice is for someone") }
    if delay > 0 { sleep(delay) }
    served += 1
    db.one("insert into invoices (name, cents) values (?, ?) returning id, name, cents", name, cents)
}

server fn summary() -> map with db {
    let row = db.one("select count(*) as n from invoices")
    { served, invoices: row.n }
}
