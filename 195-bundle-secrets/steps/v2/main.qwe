// The bake sale's Pay page, the "fix": the variable renamed PUBLIC_..., so the page may read it.
component Pay() {
    let secret = env("PUBLIC_PAYLY_SECRET")
    <div>
        <button onclick={() => {
            http.post("https://api.payly.example/v1/charges", { amount: 450 },
                { authorization: `Bearer ${secret}` })
        }}>Pay $4.50</button>
        <p class="status">Payly secret: {secret != null ? "loaded ✓" : "missing"}</p>
    </div>
}

route GET / =
    <html><head><title>Bake sale</title></head>
    <body style="font: 24px system-ui; margin: 32px">
        <h1>🧁 Bake sale</h1>
        <p>Lemon cupcake · $4.50</p>
        <Pay/>
    </body></html>
