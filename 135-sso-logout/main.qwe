// One of the club's sites (Trail Club, Photo Album): log in with the club's OpenID Connect provider, by hand.
let css = read_file("club.css")
let issuer = env("ISSUER", "http://localhost:4000")
let provider = http.get(`${issuer}/.well-known/openid-configuration`).json
let site = env("SITE", "Trail Club")
let client_id = env("CLIENT_ID", "trail-quillo")
let base = env("BASE", "http://trail.localhost:8080")
let redirect_uri = base + "/callback"

view Page(children) = <html>
    <head><title>{site}</title><style>{raw(css)}</style></head>
    <body><main>{children}</main></body>
</html>

route GET / with http {
    let user = session().user
    if user == null { return <Page><h1>{site}</h1><p><a href="/login">Log in</a></p></Page> }
    // Does the club still vouch for you? Logging out everywhere ends every site's token at the provider.
    let bearer = { authorization: `Bearer ${user.access_token}` }
    let me = http.get(provider.userinfo_endpoint, bearer, { public_only: false })?
    if !me.ok {
        end_session()
        return redirect("/login")
    }
    <Page>
        <h1>{site}: hello, {user.name}</h1><p class="who">Signed in as {user.sub}.</p>
        <form method="post" action="/logout"><button>Log out</button></form>
        <form method="post" action="/logout/everywhere"><button class="all">Log out everywhere</button></form>
    </Page>
}

// To the provider, with a fresh state kept in the session: the answer must bring it back.
route GET /login {
    let state = crypto.token()
    set_session({ state })
    redirect(provider.authorization_endpoint + "?" + url_encode({
        response_type: "code", client_id, redirect_uri, scope: "openid profile", state }))
}

// Back from the provider: the same state, then the code for tokens, and the tokens for the user.
route GET /callback ? { code: str, state: str } with env, http {
    if !crypto.equal(state, session().state ?? "") { return respond(400, "This login wasn't started here") }
    let tokens = http.post(provider.token_endpoint, url_encode({ grant_type: "authorization_code", code,
        redirect_uri, client_id, client_secret: env("CLIENT_SECRET", "") }),
        { "content-type": "application/x-www-form-urlencoded" }, { public_only: false })?
    if !tokens.ok { return respond(502, "The provider refused the code") }
    let bearer = { authorization: `Bearer ${tokens.json.access_token}` }
    let me = http.get(provider.userinfo_endpoint, bearer, { public_only: false })?
    set_session({ user: { sub: me.json.sub, name: me.json.name, id_token: tokens.json.id_token,
        access_token: tokens.json.access_token } })
    redirect("/")
}

// Log out of this site: its session goes, and the provider still knows you.
route POST /logout {
    end_session()
    redirect("/")
}

// Log out at the provider too: this site's session goes, then the provider's end-session page, and back here.
route POST /logout/everywhere {
    let hint = (session().user ?? {}).id_token
    end_session()
    redirect(provider.end_session_endpoint + "?" + url_encode({
        id_token_hint: hint, post_logout_redirect_uri: base + "/", client_id }))
}
