// Hearth Bakery's breads: a page for the list and one for each bread, each with its own title and description.
let css = read_file("site.css")
let breads = json.parse(read_file("breads.json"))

view Page(title: str, description: str, children) = <html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <title>{title}</title>
        <meta name="description" content={description}/>
        <link rel="icon" href="/logo.png" type="image/png" sizes="48x48"/>
        <style>{raw(css)}</style>
    </head>
    <body>
        <header><a href="/" class="brand">Hearth Bakery</a></header>
        <main>{children}</main>
    </body>
</html>

route GET / = <Page title="Hearth Bakery: our breads" description="Four breads, baked each morning on Market Lane.">
    <h1>Our breads</h1>
    <ul>{for b in breads => <li><a href={`/breads/${b.slug}`}>{b.name}</a>: {b.line}</li>}</ul>
</Page>

route GET /breads/:slug {
    let b = find(breads, (x) => x.slug == slug)
        ?? reply 404 <Page title="No such bread · Hearth Bakery" description="We don't bake that one.">
            <h1>No such bread</h1><p><a href="/">See all our breads</a></p>
        </Page>
    <Page title={`${b.name} · Hearth Bakery`} description={b.line}>
        <a href="/">← All breads</a>
        <h1>{b.name}</h1>
        <p>{b.about}</p>
        <p class="price">{b.price}</p>
    </Page>
}

route GET /robots.txt = file("robots.txt")
route GET /logo.png = file("logo.png", { cache: "1y" })
