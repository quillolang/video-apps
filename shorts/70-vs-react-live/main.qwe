// A wall that every open tab sees at once.

db.open("wall.db")
db.migrate("migrations")

server fn notes() with db =
    db.query("select * from notes order by id")

server fn post(text: str) with db =
    db.exec("insert into notes (text) values (?)",
        text)

component Wall() {
    state items = live(notes)
    state draft = ""
    <div>
        <form onsubmit={() => {
            let _ = post(draft)
            draft = ""
        }}>
            <input value={draft} required
                   placeholder="say hi"/>
            <button>Post</button>
        </form>
        <ul>{for n in items ?? [] =>
            <li key={n.id}>{n.text}</li>}</ul>
    </div>
}

route GET / = <html><body><Wall/></body></html>
