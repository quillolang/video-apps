// The guestbook: a form, and every entry, newest first, kept in SQLite.
db.open("guestbook.db")
db.exec("create table if not exists entries (id integer primary key, name text not null, message text not null)")

route GET / = <html>
    <head><title>Guestbook</title></head>
    <body>
        <h1>Guestbook</h1>
        <form method="post" action="/sign">
            <input name="name" placeholder="Your name" required/>
            <input name="message" placeholder="Say hello" required/>
            <button>Sign</button>
        </form>
        <ul>{for e in db.query("select name, message from entries order by id desc") =>
            <li><b>{e.name}</b>: {e.message}</li>}</ul>
    </body>
</html>

route POST /sign { form: { name: str, message: str } } with db {
    db.exec("insert into entries (name, message) values (?, ?)", name, message)
    redirect("/")
}
