// The forms: joining, signing in, and a listing's fields (new or edited).
import ui/page.qwe use Page
view SignUpPage(problem: str?) {
    <Page title="Join Swap Board">
        <h1>Join Swap Board</h1>
        {problem != null && <p.problem>{problem}</p>}
        <form.stack method="post" action="/sign-up">
            <label>Your name <input name="name" required maxlength="40"/></label>
            <label>Email <input type="email" name="email" required/></label>
            <label>Password <input type="password" name="password" required minlength="8"/></label>
            <button>Join</button>
        </form>
    </Page>
}

view SignInPage(problem: str?, next: str) {
    <Page title="Sign in">
        <h1>Sign in</h1>
        {problem != null && <p.problem>{problem}</p>}
        <form.stack method="post" action="/sign-in">
            <input type="hidden" name="next" value={next}/>
            <label>Email <input type="email" name="email" required/></label>
            <label>Password <input type="password" name="password" required/></label>
            <button>Sign in</button>
        </form>
    </Page>
}

// A listing's fields. The browser keeps a title to 80 characters, and a condition to one of three.
view ListingFields(l: map) {
    <div.fields>
    <label>Title <input name="title" value={l.title} required maxlength="80"/></label>
    <label>Condition
        <select name="condition">
            {for c in ["new", "good", "worn"] => <option value={c} selected={l.condition == c}>{c}</option>}
        </select>
    </label>
    <label>A few words <textarea name="description" maxlength="500">{l.description}</textarea></label>
    </div>
}
