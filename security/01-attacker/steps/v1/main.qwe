// Swap Board: neighbours give away what they don't need. Members post listings; Rosa runs the board.
db.open("swap.db")
db.migrate("migrations")

use "lib/accounts.qwe"
use "lib/listings.qwe"
use "ui/page.qwe"
use "ui/forms.qwe"

route GET /static/*path = files("public", path)

route GET / {
    <Page title="Swap Board">
        <h1>Free to a good home</h1>
        {me() != null && <p><a.button href="/listings/new">Give something away</a></p>}
        <ul.listings>
            {for l in all_listings() => <li>
                <a href={`/listings/${l.id}`}>{l.title}</a> <ConditionTag c={l.condition}/>
                <span.meta>from {l.owner}</span>
            </li>}
        </ul>
    </Page>
}

route GET /listings/:id(int) {
    let l = listing(id) ?? reply 404 "No such listing"
    <Page title={l.title}>
        <h1>{l.title}</h1>
        <p><ConditionTag c={l.condition}/> <span.meta>from {l.owner}</span></p>
        <p>{l.description}</p>
        {me()?.id == l.owner_id && <p><a href={`/listings/${id}/edit`}>Edit</a></p>}
    </Page>
}

// Joining and signing in. The session keeps who you are: your id, name and role.
route GET /sign-up = <SignUpPage problem={null}/>

route POST /sign-up { form: { name: str, email: str, password: str } } {
    let m = sign_up(name, email, password)
    if is_err(m) { return respond(400, <SignUpPage problem={m.error}/>) }
    set_session({ member: m })
    redirect("/")
}

route GET /sign-in ? { next: str = "/" } = <SignInPage problem={null} next={next}/>

route POST /sign-in { form: { email: str, password: str, next: str = "/" } } {
    let m = sign_in(email, password)
    if is_err(m) { return respond(401, <SignInPage problem={m.error} next={next}/>) }
    set_session({ member: m })
    redirect(local_path(next) ?? "/")
}

route POST /sign-out {
    end_session()
    redirect("/")
}

// What only members do: post and edit listings.
routes /listings | signed_in {
    route GET /new =
        <Page title="Give something away">
            <h1>Give something away</h1>
            <form.stack method="post" action="/listings">
                <ListingFields l={{ title: "", condition: "good", description: "" }}/>
                <button>Post it</button>
            </form>
        </Page>

    route POST / { form: { title: str, condition: str, description: str } } {
        let id = add_listing(me().id, title, condition, description)?
        redirect(`/listings/${id}`)
    }

    route GET /:id(int)/edit {
        let l = listing(id) ?? reply 404 "No such listing"
        <Page title="Edit listing">
            <h1>Edit listing</h1>
            <form.stack method="post" action={`/listings/${id}`}>
                <ListingFields l={l}/>
                <button>Save</button>
            </form>
        </Page>
    }

    route POST /:id(int) { form: { title: str, condition: str, description: str } } {
        update_listing(id, title, condition, description)?
        redirect(`/listings/${id}`)
    }
}

// Rosa's page: every member.
route GET /admin with db {
    if me()?.role != "admin" { reply 403 "Admins only" }
    <Page title="Admin">
        <h1>Members</h1>
        <ul.listings>
            {for m in db.query("select name, email, role from members order by id") => <li>
                {m.name} <span.meta>{m.email} · {m.role}</span>
            </li>}
        </ul>
    </Page>
}
