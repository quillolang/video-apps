// Somebody else's site, on another port: a page about kittens, with a button that posts to Swap Board's delete.
// The browser marks the post as cross-site, and takes the visitor's own cookie along.
//   .quillo/bin/quillo run other-site/main.qwe --port 8081
route GET / =
    <html lang="en">
        <head><title>Free kittens</title></head>
        <body style="font: 20px/1.5 system-ui; padding: 24px; background: #fff8e7">
            <h1>Free kittens!</h1>
            <p>Six of them, all stripy.</p>
            <form method="post" action="http://localhost:8080/listings/3/delete">
                <button style="font: inherit; padding: 8px 16px">Claim a kitten</button>
            </form>
        </body>
    </html>
