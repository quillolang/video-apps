// The host's log-in.
import lib/host.qwe use am_host, host_log_in, host_log_out

component HostLogin() {
    state me = am_host()
    state draft = ""
    state problem = ""
    <div>
        {me ?
            <p>
                Welcome, host! Your page grows in lesson 17.{" "}
                <button onclick={() => { me = host_log_out() }}>Log out</button>
            </p>
          : <form onsubmit={() => {
                let r = host_log_in(draft)
                if is_err(r) {
                    problem = r.error
                } else {
                    me = true
                    draft = ""
                    problem = ""
                }
            }}>
                <input type="password" value={draft} placeholder="The host's password"/>
                <button>Log in</button>
            </form>}
        <p.problem>{problem}</p>
    </div>
}
