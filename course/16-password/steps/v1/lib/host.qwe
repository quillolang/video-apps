// The host: a password only the host knows, checked against its hash in .env.

server fn am_host() -> bool = session().host == true

server fn host_log_in(password: str) -> bool ! str {
    let hash = env("HOST_PASSWORD_HASH")
    if hash == null {
        return err("The host's password isn't set: put HOST_PASSWORD_HASH in .env, then start the program again.")
    }
    if !crypto.verify_password(password, hash) {
        return err("That's not the host's password.")
    }
    set_session({ ...session(), host: true })
    true
}
