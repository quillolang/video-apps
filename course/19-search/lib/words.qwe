// Words about a movie: its length, a snack note, its era, and its votes.

fn length_text(minutes: int) -> str =
    `${int(minutes / 60)} h ${minutes % 60} min`

fn snack_note(minutes: int) -> str = match minutes {
    m if m < 90 => "A short one: perfect for a school night."
    m if m <= 120 => "Just right."
    _ => "A long one: bring extra snacks!"
}

fn era(year: int) -> str = match year {
    y if y < 2000 => "A classic!"
    y if y < 2020 => "A modern one."
    _ => "Brand new!"
}

fn votes_text(votes: int) -> str = match votes {
    0 => "No votes yet"
    1 => "1 vote"
    n => `${n} votes`
}

fn found_text(q: str, n: int) -> str = match n {
    0 => `No movie matches "${q}".`
    1 => "1 movie found:"
    _ => `${n} movies found:`
}
