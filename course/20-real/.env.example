# Your own .env, in the movie-night folder (never share it, never put it on GitHub).
# HOST_PASSWORD_HASH: in the REPL, crypto.hash_password("your password"); its answer, without the quotes.
# QUILLO_SECRET: in the REPL, crypto.token(); its answer, without the quotes. It keeps sessions across restarts.
HOST_PASSWORD_HASH=
QUILLO_SECRET=
