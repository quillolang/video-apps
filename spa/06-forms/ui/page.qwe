// The page around everything: its head, the town's header, and the look.
let css = `
body { margin: 0; font: 16px/1.5 system-ui, sans-serif; color: #1f2a24; background: #f4f1ea; }
header { background: #2f5d46; color: #fff; padding: 14px 24px; display: flex; align-items: baseline; gap: 18px; }
header b { font-size: 21px; letter-spacing: .3px; }
header a { color: #d9eadf; text-decoration: none; }
header a.here { color: #fff; font-weight: 600; }
main { max-width: 640px; margin: 0 auto; padding: 18px 24px 40px; }
h1 { font-size: 26px; margin: 8px 0 4px; }
ul.trails { list-style: none; padding: 0; margin: 12px 0; }
ul.trails li { background: #fff; border-radius: 10px; padding: 12px 16px; margin: 8px 0; display: flex; align-items: center; gap: 12px; box-shadow: 0 1px 2px #0001; }
ul.trails a { color: #1f4a35; font-weight: 600; text-decoration: none; flex: 1; }
.level { font-size: 13px; padding: 2px 9px; border-radius: 99px; }
.easy { background: #dff1e4; color: #1d6b3a; } .medium { background: #fbecc8; color: #8a5a00; } .hard { background: #f8d9d4; color: #9b2c1e; }
.facts { color: #5b6b62; font-size: 14px; }
.about { font-size: 17px; }
svg.profile { width: 100%; height: 130px; background: #fff; border-radius: 10px; margin: 8px 0; }
.profile.blank { height: 130px; background: #fff; opacity: .5; }
.back { color: #2f5d46; }
.plan { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
button { font: inherit; padding: 7px 14px; border-radius: 8px; border: 0; background: #2f5d46; color: #fff; cursor: pointer; }
button:disabled { background: #b9c7bf; cursor: default; }
.filters { display: flex; gap: 8px; flex-wrap: wrap; margin: 10px 0 2px; }
.filters button, .filters a { background: #fff; color: #2f5d46; border: 1px solid #c9d6ce; border-radius: 99px; padding: 4px 12px; font-size: 14px; text-decoration: none; }
.filters button { text-transform: capitalize; }
form.log { display: grid; gap: 12px; max-width: 360px; }
form.log label { display: grid; gap: 4px; font-size: 14px; color: #5b6b62; }
form.log input, form.log textarea { font: inherit; padding: 7px 10px; border: 1px solid #c9d6ce; border-radius: 8px; background: #fff; }
.problem { color: #9b2c1e; margin: 0; }
main p a { color: #2f5d46; }
a.button { padding: 7px 14px; border-radius: 8px; border: 1px solid #2f5d46; color: #2f5d46; background: #fff; text-decoration: none; }
.filters .here { background: #2f5d46; color: #fff; border-color: #2f5d46; }
`

view Page(title: str, children) =
    <html>
        <head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><style>{raw(css)}</style></head>
        <body>{children}</body>
    </html>
