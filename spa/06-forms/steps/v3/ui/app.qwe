// The whole guide as one component: the address picks the page, and a link changes it without loading one.
import ui/trails.qwe use Header, TrailList, TrailPage, PlanPage, About, NotFound
import ui/hikes.qwe use LogForm, HikePage, HikeList

// Which page an address is. The App shows it, and the server answers with its status.
fn page_of(path: str) -> map = match split(path, "/") | filter((s) => s != "") {
    [] => { page: "list" }
    ["trails", piece] => numbered("trail", piece)
    ["trails", piece, "log"] => numbered("log", piece)
    ["hikes"] => { page: "hikes" }
    ["hikes", piece] => numbered("hike", piece)
    ["plan"] => { page: "plan" }
    ["about"] => { page: "about" }
    _ => { page: "missing" }
}

// A page for a number in the address, written the one way; any other piece is missing.
fn numbered(page: str, piece: str) -> map {
    let id = int(piece)                       // an error value for "abc"; 5 for "05"
    is_err(id) || str(id) != piece ? { page: "missing" } : { page, id }
}

component App() {
    // The weekend's trails, in App so every page shares them, and kept in the browser for the next visit.
    // On the server, js() is null, so the plan starts empty; in the browser this runs again and reads it back.
    state plan = saved(js("localStorage.getItem", "plan"))
    fn keep(trails: list) {
        plan = trails
        js("localStorage.setItem", "plan", json.stringify(trails))
    }
    let path = url().path
    let at = page_of(path)
    <div>
        <Header {path} count={len(plan)}/>
        {match at.page {
            "list" => <TrailList/>
            "trail" => <TrailPage key={at.id} id={at.id} {plan} on_add={(t) => keep(plan | push(t))}/>
            "log" => <LogForm key={at.id} trail_id={at.id}/>
            "hikes" => <HikeList/>
            "hike" => <HikePage key={at.id} id={at.id}/>
            "plan" => <PlanPage {plan} on_remove={(t) => keep(plan | filter((x) => x.id != t.id))}/>
            "about" => <About/>
            _ => <NotFound {path}/>
        }}
    </div>
}

// The plan as the browser keeps it: JSON text, or nothing yet.
fn saved(text) -> list = text == null ? [] : json.parse(text) ?? []
