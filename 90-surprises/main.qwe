// JavaScript's famous surprises, asked in Quillo: quillo run main.qwe prints each answer.
// ("5" - 2, date.of(2026, 2, 31) and +"a" are left out: each is an error that stops a script.)
print("0.1 + 0.2 is", 0.1 + 0.2, "and 0.1m + 0.2m is", 0.1m + 0.2m)
print("9007199254740993 is", 9007199254740993)
print("max([]) is", max([]))
print("sqrt(-1) == sqrt(-1) is", sqrt(-1) == sqrt(-1))
print(`"5" + 2 is`, "5" + 2)
print(`int("12px") is`, int("12px"))
print(`["1", "2", "3"] | map(int) is`, ["1", "2", "3"] | map(int))
print("[] == ![] is", [] == ![])
print("[1, 2] == [1, 2] is", [1, 2] == [1, 2])
print("type_of(null) is", type_of(null))
print(`0 || "none" is`, 0 || "none")
print("sort([10, 9, 1]) is", sort([10, 9, 1]))
print("[1, 2, 3] + [4, 5, 6] is", [1, 2, 3] + [4, 5, 6])
