// The frame every page shares: who is signed in, the title, the stylesheet, and what goes in it.
import lib/accounts.qwe use me

view Page(title: str, children) {
    let user = me()
    <html lang="en">
        <head>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <title>{title}</title>
            <link rel="stylesheet" href="/static/style.css"/>
        </head>
        <body>
            <header.top>
                <a href="/">Recipe Box</a>
                {user != null
                    ? <form method="post" action="/logout">
                        <a href="/my">My recipes</a> · Signed in as {user.name} <button>Log out</button>
                    </form>
                    : <span><a href="/login">Log in</a> · <a href="/signup">Sign up</a></span>}
            </header>
            <main>{children}</main>
        </body>
    </html>
}
