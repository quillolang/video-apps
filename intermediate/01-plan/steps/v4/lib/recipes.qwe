// Recipes and their ingredients: the types, and the queries that read them.
type Recipe = { id: int, title: str, servings: int, minutes: int }
type Ingredient = { id: int, recipe_id: int, name: str, amount: str, unit: str }

fn all_recipes() -> list<Recipe> with db = db.query("select * from recipes order by title")
fn recipe(id: int) with db = db.one("select * from recipes where id = ?", id)
fn ingredients_of(id: int) -> list<Ingredient> with db =
    db.query("select * from ingredients where recipe_id = ? order by id", id)

// The recipes that use an ingredient, with how much of it each one needs.
fn recipes_using(item: str) -> list with db = db.query(sql`
    select r.id as recipe_id, r.title, i.amount, i.unit, i.name
    from ingredients i join recipes r on r.id = i.recipe_id
    where i.name like ?
    order by r.title`, `%${item}%`)
