// The week's plan, and the shopping list.
import ui/page.qwe use Page
import lib/amounts.qwe use amount_text

view PlanPage(days: list, plans: list) =
    <Page title="This week">
        <h1>This week</h1>
        <ul.recipes>{for day in days => <li>
            <b>{date.format(day, "dddd D MMMM")}</b>
            {for p in filter(plans, (p) => p.day == day) =>
                <div><a href={`/recipes/${p.id}`}>{p.title}</a> <span.meta>for {p.servings}</span></div>}
        </li>}</ul>
        <p><a href="/my/shopping">The shopping list</a></p>
    </Page>

view ShoppingPage(items: list) =
    <Page title="Shopping list">
        <h1>Shopping list</h1>
        {len(items) == 0
            ? <p.meta>Nothing planned this week.</p>
            : <ul.recipes>{for x in items =>
                <Item key={`${x.name}|${x.unit}`} text={`${amount_text(x.total)} ${x.unit} ${x.name}`}/>}</ul>}
        <p><a href="/my/plan">This week</a></p>
    </Page>

// One thing to buy: tick it when it's in the basket.
component Item(text: str) {
    state got = false
    <li class={got && "got"}><label><input type="checkbox" checked={got}/> {text}</label></li>
}
