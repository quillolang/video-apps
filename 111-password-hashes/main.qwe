// Dawn Runners, in Quillo: the members in SQLite, and a page that lists them.
db.open("club.db")
db.migrate("migrations")

// What the page gets of a member: their name, and when they joined.
type Member = { name: str, joined: date }

// The members, for the page: those two columns, each row made a Member.
server fn members() -> list<Member> with db =
    db.query("select name, joined from members order by id") | map(Member)

component Members() {
    style css`li { margin: .4rem 0 }`
    state list = members()
    <ul>{for m in list => <li key={m.name}>{m.name}, since {m.joined}</li>}</ul>
}

route GET / = <html>
    <head><title>Dawn Runners</title></head>
    <body style="font: 20px system-ui; margin: 2rem">
        <h1>Our members</h1>
        <Members/>
    </body>
</html>
