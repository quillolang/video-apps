// Wikiwiki: a tiny wiki. Pages in Markdown, [[links]] between them, and every save kept,
// so each page has a history.

db.open("wiki.db")
db.migrate("migrations")

fn slug(name: str) -> str = replace(trim(name), " ", "_")
fn title(page: str) -> str = replace(page, "_", " ")

fn latest(name: str) -> map? with db =
    db.one("select id, body, at from pages where name = ? order by id desc limit 1", name)

// [[Bread Oven]] becomes a link: to the page if there is one, or "Bread Oven?" to start it.
fn links(body: str) -> str with db = re.replace(body, "\\[\\[([^\\]]+)\\]\\]", (m) => {
    let name = m.groups[0]
    latest(name) == null ? `[${name}?](/wiki/${slug(name)}/edit)` : `[${name}](/wiki/${slug(name)})`
})

view Page(name: str, children) =
    <html>
        <head><title>{name} · Wikiwiki</title><link rel="stylesheet" href="/static/style.css"/></head>
        <body><main>
            <nav>
                <a href="/wiki/Home">🥖 Wikiwiki</a>
                <a href={`/wiki/${slug(name)}/edit`}>Edit</a>
                <a href={`/wiki/${slug(name)}/history`}>History</a>
            </nav>
            <h1>{name}</h1>
            {children}
        </main></body>
    </html>

route GET / = redirect("/wiki/Home")

route GET /wiki/:page with db {
    let p = latest(title(page))
    if p == null { return redirect(`/wiki/${page}/edit`) }
    <Page name={title(page)}>{markdown(links(p.body))}</Page>
}

route GET /wiki/:page/edit with db {
    let body = (latest(title(page)) ?? { body: "" }).body
    <Page name={title(page)}>
        <form method="post">
            <textarea name="body" rows="8" aria-label="The page, in Markdown">{body}</textarea>
            <button>Save</button>
        </form>
    </Page>
}

route POST /wiki/:page/edit { form: { body: str } } with db, time {
    db.exec("insert into pages (name, body, at) values (?, ?, ?)", title(page), body, date.now())
    redirect(`/wiki/${page}`)
}

route GET /wiki/:page/history with db =
    <Page name={title(page)}>
        <ol.history reversed>
            {for v in db.query("select id, at from pages where name = ? order by id desc", title(page)) =>
                <li><a href={`/wiki/${page}/v/${v.id}`}>{v.at}</a></li>}
        </ol>
    </Page>

route GET /wiki/:page/v/:id(int) with db {
    let v = db.one("select body, at from pages where id = ? and name = ?", id, title(page))
    if v == null { reply 404 "no such version" }
    <Page name={title(page)}><p.old>As it was at {v.at}</p>{markdown(links(v.body))}</Page>
}

route GET /static/*path = files("public", path)
