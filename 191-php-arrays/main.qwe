// PHP 8.6 Quirks #2, in Quillo: the PHP pages and APIs, each written the Quillo way, at /catalog,
// /api/zips, /api/scores, /guests and /invited. The styles are the PHP pages' own (quirks.css).
let css = read_file("quirks.css")

let lamps = { "101": "Desk lamp", "102": "Floor lamp" }
let chairs = { "205": "Stool", "206": "Armchair" }
let catalog = merge(lamps, chairs)

route GET /catalog = Page(<main>
    <h1>Catalog</h1>
    <ul class="plain">
        {for id in keys(catalog) => <li>#{id} {catalog[id]}</li>}
    </ul>
</main>)

let cities = { "08001": "Barcelona", "10001": "New York", "75001": "Paris" }

route GET /api/zips = keys(cities)

let scores = [3, 0, 5, 0, 8]

route GET /api/scores = filter(scores, (s) => s > 0)

let guests = map(["ana", "ben", "cy"], (g) => upper(take(g, 1)) + drop(g, 1))

route GET /guests = Page(<main>
    <h1>Guests</h1>
    <ul>{for guest in guests => <li>{guest}</li>}</ul>
</main>)

let invited = ["Ana", "Ben", "Cy"]

route GET /invited ? { name: str = "Ana" } = Page(<main>
    <h1>Invited?</h1>
    <p class="result">{name} {contains(invited, name) ? "is invited" : "is not on the list"}</p>
</main>)

view Page(body) = <html>
    <head><title>Quillo Quirks</title><style>{raw(css)}</style></head>
    <body>{body}</body>
</html>

route GET / = redirect("/catalog")
