// The bakery's basket: what you've added is kept in your session.
route GET / {
    let n = count(session().basket ?? [])
    <html><head><title>Your basket</title></head><body>
        <h1>Your basket: {n} {n == 1 ? "loaf" : "loaves"}</h1>
        <form method="post" action="/add"><button name="loaf" value="Sourdough">Add a sourdough</button></form>
    </body></html>
}

route POST /add { form: { loaf: str } } {
    set_session({ ...session(), basket: (session().basket ?? []) | push(loaf) })
    redirect("/")
}
