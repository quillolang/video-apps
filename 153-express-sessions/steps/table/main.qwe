// The bakery's basket, kept in a table: the session holds only the basket's id, as Quillo's guide says.
db.open("basket.db")
db.migrate("migrations")

route GET / with db {
    let n = db.one("select count(*) as n from loaves where basket = ?", session().basket ?? "").n
    <html><head><title>Your basket</title></head><body>
        <h1>Your basket: {n} {n == 1 ? "loaf" : "loaves"}</h1>
        <form method="post" action="/add"><button name="loaf" value="Sourdough">Add a sourdough</button></form>
    </body></html>
}

route POST /add { form: { loaf: str } } with db, random {
    let basket = session().basket ?? uuid()
    if session().basket == null { set_session({ basket }) }
    db.exec("insert into loaves (basket, loaf) values (?, ?)", basket, loaf)?
    redirect("/")
}
