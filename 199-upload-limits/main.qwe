// The trail club's photo upload in Quillo: a request body is 10 MB at most unless --max-body says
// otherwise, and the route checks the photo's own size before saving it.
route POST /photos with fs, random {
    let f = request.files.photo
    if f == null { reply 400 "Choose a photo" }
    if f.size > 2_000_000 { reply 413 "Photos up to 2 MB" }
    save_upload(f, `uploads/${uuid()}.jpg`)?
    `Saved ${f.size} bytes`
}
