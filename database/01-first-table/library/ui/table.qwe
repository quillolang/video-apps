// Any rows, as a table: a column for each of the first row's keys.
view Table(title: str, rows: list) =
    <html lang="en">
        <head>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <title>{title}</title>
            <link rel="stylesheet" href="/static/style.css"/>
        </head>
        <body>
            <h1>{title}</h1>
            {len(rows) == 0 ? <p>No rows yet.</p> :
                <table>
                    <tr>{for k in keys(rows[0]) => <th>{k}</th>}</tr>
                    {for r in rows => <tr>{for k in keys(rows[0]) => <td>{str(r[k])}</td>}</tr>}
                </table>}
        </body>
    </html>
