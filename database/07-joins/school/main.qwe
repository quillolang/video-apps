// The School: its database, and a page for each question we ask it.
db.open("school.db")
db.migrate("migrations")
use "ui/table.qwe"

// A page with a question, and the database's answer.
fn answer(title: str, question: str) with db = <Table title={title} sql={question} rows={db.query(question)}/>

route GET / with db = answer("Every student", sql`
    select * from students`)

route GET /year-7 with db = answer("Year 7, by name", sql`
    select name, birthday
    from students
    where year_level = 7
    order by name`)

route GET /youngest with db = answer("The youngest", sql`
    select name, birthday
    from students
    order by birthday desc
    limit 1`)

// The students in one year: the year comes from the address, as an int, and goes in as a value.
let IN_YEAR = sql`
    select name, birthday
    from students
    where year_level = :year
    order by name`

route GET /year ? { year: int = 7 } with db =
    <Table title={`Year ${year}`} sql={IN_YEAR} rows={db.query(IN_YEAR, { year })}>
        <form><input name="year" type="number" value={str(year)}/><button>Show</button></form>
    </Table>

route GET /static/*path = files("public", path)
