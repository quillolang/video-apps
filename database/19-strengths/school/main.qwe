// The School: its database, and a page for each question we ask it.
db.open("school.db")
db.migrate("migrations")
use "ui/table.qwe"

// A page with a question, and the database's answer.
fn answer(title: str, question: str) with db = <Table title={title} sql={question} rows={db.query(question)}/>

route GET / with db = answer("Every student", sql`
    select * from students`)

route GET /year-7 with db = answer("Year 7, by name", sql`
    select name, birthday
    from students
    where year_level = 7
    order by name`)

route GET /youngest with db = answer("The youngest", sql`
    select name, birthday
    from students
    order by birthday desc
    limit 1`)

// The students in one year: the year comes from the address, as an int, and goes in as a value.
let IN_YEAR = sql`
    select name, birthday
    from students
    where year_level = :year
    order by name`

route GET /year ? { year: int = 7 } with db =
    <Table title={`Year ${year}`} sql={IN_YEAR} rows={db.query(IN_YEAR, { year })}>
        <form><input name="year" type="number" value={str(year)}/><button>Show</button></form>
    </Table>

// Who takes which class: each row of the table in between, with its class's name and its student's.
let WHO_TAKES_WHAT = sql`
    select classes.name as class, students.name as student
    from enrollments
    join classes on classes.id = enrollments.class_id
    join students on students.id = enrollments.student_id
    order by classes.name, students.name`

route GET /classes with db = answer("Who takes what", WHO_TAKES_WHAT)

// Enroll a student in a class, by their ids: one more row in the table in between.
fn enroll_page(message: str) with db =
    <Table title="Enroll a student" sql={WHO_TAKES_WHAT} rows={db.query(WHO_TAKES_WHAT)}>
        <form method="post" action="/enroll">
            <input name="student_id" placeholder="Student's id"/>
            <input name="class_id" placeholder="Class's id"/>
            <button>Enroll</button>
        </form>
        {message != "" && <p.message>{message}</p>}
    </Table>

route GET /enroll with db = enroll_page("")

route POST /enroll { form: { student_id: int, class_id: int } } with db {
    // The enrollment and its seat, all or nothing: a full class (seats_left would go below 0) undoes it.
    let done = db.transaction(() => {
        let r = db.exec("insert into enrollments (student_id, class_id) values (?, ?) on conflict do nothing",
            student_id, class_id)?
        if r.changes == 0 { return err("already") }
        db.exec("update classes set seats_left = seats_left - 1 where id = ?", class_id)
    })
    if db.error_kind(done) == "check" { return enroll_page("That class is full.") }
    if is_err(done) { return enroll_page("That student is in that class already.") }
    redirect("/enroll")
}

// Each class, and the seats it has left.
route GET /seats with db = answer("Seats left", sql`
    select id, name, seats_left from classes order by id`)

// Each class's average grade, and how many students it has.
route GET /averages with db = answer("Class averages", sql`
    select classes.name as class,
        count(*) as students,
        round(avg(enrollments.grade), 1) as average
    from enrollments
    join classes on classes.id = enrollments.class_id
    group by classes.id
    order by average desc, class`)

// Each student's email, and whose it is.
route GET /emails with db = answer("Students' emails", sql`
    select name, email from students order by name`)

// Each class's ranking: rank() numbers the students of each class (partition by) from the best grade down. Two
// with the same grade share a place, and the next place is skipped.
let RANKINGS = sql`
    select classes.name as class, students.name, enrollments.grade,
        rank() over (partition by enrollments.class_id order by enrollments.grade desc) as place
    from enrollments
    join students on students.id = enrollments.student_id
    join classes on classes.id = enrollments.class_id
    order by classes.name, place`

route GET /rankings with db = answer("Each class's ranking", RANKINGS)

// The best in each class. A window can't go in where, so the ranking is a named step first (with), and the
// question asks it, as it would a table.
let TOP = sql`
    with ranked as (
        select enrollments.class_id, enrollments.student_id, enrollments.grade,
            rank() over (partition by enrollments.class_id order by enrollments.grade desc) as place
        from enrollments
    )
    select classes.name as class, students.name, ranked.grade
    from ranked
    join students on students.id = ranked.student_id
    join classes on classes.id = ranked.class_id
    where ranked.place = 1
    order by classes.name`

route GET /top with db = answer("Top of each class", TOP)

route GET /static/*path = files("public", path)
