// The Library: its database, and a page for each question we ask it.
db.open("library.db")
db.migrate("migrations")
use "ui/table.qwe"

// A page with a question, and the database's answer.
fn answer(title: str, question: str) with db = <Table title={title} sql={question} rows={db.query(question)}/>

route GET / with db = answer("Every book", sql`
    select * from books`)

route GET /austen with db = answer("Jane Austen's books", sql`
    select title, year
    from books
    where author = 'Jane Austen'
    order by year`)

route GET /newest with db = answer("Newest first", sql`
    select title, author, year
    from books
    order by year desc`)

route GET /members with db = answer("Every member", sql`
    select * from members`)

route GET /no-email with db = answer("Members with no email", sql`
    select name, joined
    from members
    where email is null`)

// A member, by name, from a form: the name goes in as a value, never into the SQL.
let FIND_MEMBER = sql`
    select name, joined, email
    from members
    where name = :name`

route GET /member ? { name: str = "" } with db =
    <Table title="A member" sql={FIND_MEMBER} rows={db.query(FIND_MEMBER, { name })}>
        <form><input name="name" value={name} placeholder="A member's name"/><button>Find</button></form>
    </Table>

// New members join here. The table keeps one member per email; no email at all is fine.
let MEMBERS = sql`
    select * from members`

fn join_page(message: str) with db =
    <Table title="Join the library" sql={MEMBERS} rows={db.query(MEMBERS)}>
        <form method="post" action="/join">
            <input name="name" placeholder="Your name"/>
            <input name="email" placeholder="Your email, if you like"/>
            <button>Join</button>
        </form>
        {message != "" && <p.message>{message}</p>}
    </Table>

route GET /join with db = join_page("")

route POST /join { form: { name: str, email: str } } with db {
    // An empty box is no email at all: null, which is never taken. "" is a value, and a second "" would be.
    let address = email == "" ? null : email
    let r = db.exec("insert into members (name, joined, email) values (?, date('now'), ?)", name, address)
    if db.error_kind(r) == "unique" { return join_page("That email already belongs to a member.") }
    r?
    redirect("/join")
}

// The books out, and who has them: each loan, with its book's title and its member's name.
// Fifty to a page, in the order they went out. A page starts after the last loan of the one before it.
let LOANS_AFTER = sql`
    select loans.id, books.title, members.name, loans.due
    from loans
    join books on books.id = loans.book_id
    join members on members.id = loans.member_id
    where loans.id > :after
    order by loans.id
    limit 50`

route GET /loans ? { after: int = 0 } with db {
    let rows = db.query(LOANS_AFTER, { after })
    <Table title="Books out" sql={LOANS_AFTER} rows={rows}>
        {len(rows) == 50 && <p><a href={`/loans?after=${rows[49].id}`}>Next page</a></p>}
    </Table>
}

// Every member, and the books they have out. A member with none still gets a row, with null.
route GET /who-has-what with db = answer("Who has what", sql`
    select members.name, books.title
    from members
    left join loans on loans.member_id = members.id
    left join books on books.id = loans.book_id
    order by members.id`)

// Members can be removed here, but not while they have books out: their loans point at them.
fn remove_page(message: str) with db =
    <Table title="Remove a member" sql={MEMBERS} rows={db.query(MEMBERS)}>
        <form method="post" action="/remove">
            <input name="id" placeholder="Member's id"/>
            <button>Remove</button>
        </form>
        {message != "" && <p.message>{message}</p>}
    </Table>

route GET /remove with db = remove_page("")

route POST /remove { form: { id: int } } with db {
    let r = db.exec("delete from members where id = ?", id)
    if db.error_kind(r) == "foreign_key" { return remove_page("That member has books out: they come back first.") }
    r?
    redirect("/remove")
}

// An author's books, through the table in between: from the author, to each of their rows, to each book.
let BY_AUTHOR = sql`
    select books.title, books.year
    from authors
    join book_authors on book_authors.author_id = authors.id
    join books on books.id = book_authors.book_id
    where authors.name = :name
    order by books.year`

route GET /by-author ? { name: str = "Neil Gaiman" } with db =
    <Table title={`Books by ${name}`} sql={BY_AUTHOR} rows={db.query(BY_AUTHOR, { name })}>
        <form><input name="name" value={name} placeholder="An author's name"/><button>Find</button></form>
    </Table>

// Each member's loans: every member, joined to their loans, grouped by member. count(loans.id) counts only
// the rows where a loan matched, so a member with none has 0.
route GET /loans-per-member with db = answer("Loans per member", sql`
    select members.name,
        count(loans.id) as loans
    from members
    left join loans on loans.member_id = members.id
    group by members.id
    order by members.id`)

// Members with two loans or more: having filters the groups, after they're counted.
route GET /busy-members with db = answer("Two loans or more", sql`
    select members.name,
        count(loans.id) as loans
    from members
    left join loans on loans.member_id = members.id
    group by members.id
    having count(loans.id) >= 2`)

// Members by last name, with their phone: the new columns at work.
route GET /by-last-name with db = answer("Members, by last name", sql`
    select last_name, first_name, phone
    from members
    order by last_name`)

// What each member owes in late fines, and the total: added up in whole cents, and only shown as dollars.
let FINES = sql`
    select members.name, sum(fines.fine_cents) as cents
    from fines join members on members.id = fines.member_id
    group by members.id
    union all
    select 'Total', sum(fine_cents) from fines`

route GET /fines with db {
    let rows = db.query(FINES) | map((r) => { name: r.name, owes: money.format(money.from_minor(r.cents, "USD")) })
    <Table title="Fines owed" sql={FINES} rows={rows}/>
}

// A member's loans, the soonest due first.
let MEMBER_LOANS = sql`
    select id, book_id, due
    from loans
    where member_id = :id
    order by due`

route GET /loans-of ? { id: int = 7 } with db =
    <Table title="A member's loans" sql={MEMBER_LOANS} rows={db.query(MEMBER_LOANS, { id })}>
        <form><input name="id" value={str(id)} aria-label="A member's number"/><button>Show</button></form>
    </Table>

// A member, by email, however they typed it: "Ada@Example.com" finds ada@example.com.
let BY_EMAIL = sql`
    select name, joined, email
    from members
    where lower(email) = lower(:email)`

route GET /find ? { email: str = "" } with db =
    <Table title="Find a member" sql={BY_EMAIL} rows={db.query(BY_EMAIL, { email })}>
        <form><input name="email" value={email} placeholder="An email"/><button>Find</button></form>
    </Table>

// A backup each night, at 02:00 UTC, named by the date: backups/library-2026-11-20.db. vacuum into writes a copy
// that's whole, even while pages are being served; the path counts from the folder the program was started in,
// so start it from its own folder, as run.sh is run.
fn nightly_backup() -> map ! str with db, time = db.exec("vacuum into ?", `backups/library-${date.today()}.db`)

schedule("0 2 * * *", nightly_backup)

route GET /static/*path = files("public", path)
