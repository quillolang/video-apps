// The frame every page shares.
view Page(title: str, children) =
    <html lang="en">
        <head>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <title>{title}</title>
            <link rel="stylesheet" href="/static/style.css"/>
        </head>
        <body><main>{children}</main></body>
    </html>
