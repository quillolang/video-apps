// The mail service: it takes an email to send, and keeps it. Here it only writes it down, in its own database,
// standing in for a real mail provider.
db.open("mailer.db")
db.exec("create table if not exists sent (id integer primary key, to_addr text not null, subject text not null)")

server fn email(to: str, subject: str) -> map =
    db.one("insert into sent (to_addr, subject) values (?, ?) returning id", to, subject)

server fn sent_to(address: str) -> list = db.query("select * from sent where to_addr = ? order by id", address)
