// The team's activity, as it happens: the page follows the server's feed.
component Feed() {
    state lines = []
    listen("/activity", (all) => { lines = all | reverse | take(5) })
    <section>
        <h2>Activity</h2>
        <ul.feed>{for a in lines => <li key={a.id}><b>{a.who}</b> {a.what}</li>}</ul>
    </section>
}
