// The team's activity: a line for everything that happens, and a feed of it for the page.
fn note(what: str) with db =
    db.exec("insert into activity (who, what) values (?, ?)", session().name ?? "Someone", what)

// The feed, as Server-Sent Events: every second, if anything is new, the whole history again.
route GET /activity with db, time = events((send) => {
    let last = 0
    while true {
        let newest = db.one("select max(id) as id from activity").id ?? 0
        if newest > last {
            send(db.query("select * from activity order by id"))
            last = newest
        } else {
            send(null)
        }
        sleep(1000)
    }
})
