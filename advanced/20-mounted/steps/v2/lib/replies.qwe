// A ticket's replies, live on its page. A topic for each ticket: a reply wakes only that ticket's pages.
import lib/activity.qwe use note

server fn load_replies(ticket: int) -> list {
    if session().role == null { return [] }    // for agents only, like the desk
    watch(`ticket:${ticket}`)
    unwatched(() => db.query("select * from replies where ticket_id = ? order by id", ticket))
}

// A reply runs once, however many times it's sent: a double click is one call, and a call sent again with its key
// gets the first answer.
server fn add_reply(ticket: int, body: str) -> map ! str = idempotent(() => {
    if session().role == null { return err("Only agents can reply.") }
    let made = db.exec("insert into replies (ticket_id, author, body) values (?, ?, ?)",
        ticket, session().name ?? "Someone", trim(body))?
    publish(`ticket:${ticket}`)
    note(`replied on ${db.one("select title from tickets where id = ?", ticket).title}`)?
    made
})
