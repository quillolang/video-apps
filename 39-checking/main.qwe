// The little library: books to borrow, and who has each one.

type Book = { id: int, title: str, author: str, out: str = "" }

let books = [
    Book({ id: 1, title: "The Clockwork Garden", author: "M. Fern" }),
    Book({ id: 2, title: "Seven Quiet Owls", author: "L. Ashby" }),
    Book({ id: 3, title: "A Map of Small Things", author: "R. Okafor" }),
]
let history = []

// A borrower gives a name of two letters or more.
fn valid_name(name: str) -> bool {
    len(trim(name)) >= 2
}

view Lend(b: Book) =
    <form class="lend" method="post" action={`/borrow/${b.id}`}>
        <input name="who" placeholder="Your name"/><button>Borrow</button>
    </form>

view Back(b: Book) =
    <form method="post" action={`/return/${b.id}`}>
        With {b.out} <button>Return</button>
    </form>

view Shelf(b: Book) =
    <li class={b.out == "" ? "in" : "out"}>
        <b>{b.title}</b> <small>by {b.author}</small>
        {b.out == "" ? <Lend b={b}/> : <Back b={b}/>}
    </li>

route GET / = <html>
    <head><title>The little library</title><link rel="stylesheet" href="/static/style.css"/></head>
    <body><main>
        <h1>📚 The little library</h1>
        <p.count>{count(books, (b) => b.out == "")} of {len(books)} on the shelf</p>
        <ul.shelf>{for b in books => <Shelf b={b}/>}</ul>
    </main></body>
</html>

route POST /borrow/:id(int) { form: { who: str } } {
    let b = find(books, (x) => x.id == id) ?? reply 404 "No such book"
    if !valid_name(who) { reply 400 "Your name, please" }
    if b.out != "" { reply 409 `Already out, with ${b.out}` }
    books = map(books, (x) => x.id == id ? { ...x, out: trim(who) } : x)
    history = history | push({ who, id })
    print(`${trim(who)} borrowed ${b.title}`)
    redirect("/")
}

route POST /return/:id(int) {
    if index_of(map(books, (x) => x.id), id) == null { reply 404 "No such book" }
    books = map(books, (x) => x.id == id ? { ...x, out: "" } : x)
    redirect("/")
}

route GET /static/*path = files("public", path)
