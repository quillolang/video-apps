// Kudos: a team board kept in a database. Its tables come from migrations/.

db.open("data/team.db") | unwrap
db.migrate("migrations")

use lib/team.qwe
use ui/board.qwe

view Page(title: str, children) =
    <html>
        <head>
            <title>{title}</title>
            <link rel="stylesheet" href="/static/style.css"/>
        </head>
        <body><main><h1>{title}</h1>{children}</main></body>
    </html>

route GET / = <Page title="Kudos"><Board/></Page>

route GET /static/*path = files("public", path)
