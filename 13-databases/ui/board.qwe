// The kudos board: everyone's points, live from the database, and the buttons that change them.

import lib/team.qwe use people, recent, give, add_person

component Board() {
    state list = live(people)
    state notes = live(recent)
    state me = "1"
    state note = "Great demo!"
    state name = ""
    state problem = null

    let kudos = (to) => {
        let r = give(int(me) ?? 1, to, note)
        problem = is_err(r) ? r.error : null
    }
    let add = () => {
        let r = add_person(name)
        problem = is_err(r) ? r.error : null
        if !is_err(r) { name = "" }
    }

    <section.card>
        <label.row>
            You are <select value={me}>{for p in list => <option value={str(p.id)}>{p.name}</option>}</select>
        </label>
        <label.row>For <input value={note}/></label>
        <ol.board>
            {for p in list =>
                <li key={p.id}>
                    <b>{p.name}</b> <span>{p.points} kudos, {p.budget} to give</span>
                    <button onclick={() => kudos(p.id)}>Kudos</button>
                </li>}
        </ol>
        {problem != null && <p.problem>{problem}</p>}
        <ul.recent>{for k in notes => <li>{k.giver} to {k.taker}: {k.note}</li>}</ul>
        <form.row onsubmit={add}><input value={name} placeholder="Someone new"/> <button>Add</button></form>
    </section>
}
