// <Notes>: made on the server, then run in the browser. It adds, edits and deletes notes
// with the server functions in lib/notes.qwe, and live() keeps every open tab up to date.

use lib/notes.qwe

component Notes() {
    state notes = live(list_notes)
    state title = ""
    state body = ""
    state problem = null
    state editing = null
    state edit_title = ""
    state edit_body = ""
    let start_edit = (n) => {
        editing = n.id
        edit_title = n.title
        edit_body = n.body
    }
    let save = (id) => {
        let r = update_note(id, edit_title, edit_body)
        if is_err(r) { problem = r.error } else { editing = null }
    }
    let remove = (n) => {
        if ask(`Delete "${n.title}"?`) {
            let r = delete_note(n.id)
            if is_err(r) { problem = r.error }
        }
    }
    <section>
        <form @submit={() => {
            let r = add_note(title, body)
            if is_err(r) {
                problem = r.error
            } else {
                title = ""
                body = ""
                problem = null
            }
        }}>
            <input bind:value={title} placeholder="Title"/>
            <textarea bind:value={body} placeholder="Write something…" rows="3"></textarea>
            <button>Add note</button>
        </form>
        {problem && <p.problem>{problem}</p>}
        <ul>{for n in notes ?? [] => <li key={n.id}>
            {editing == n.id ? <form @submit={() => save(n.id)}>
                <input bind:value={edit_title}/>
                <textarea bind:value={edit_body} rows="3"></textarea>
                <div>
                    <button>Save</button>
                    <button type="button" @click={() => { editing = null }}>Cancel</button>
                </div>
            </form> : <div>
                <h3>{n.title}</h3>
                <p>{n.body}</p>
                <button type="button" @click={() => start_edit(n)}>Edit</button>
                <button type="button" @click={() => remove(n)}>Delete</button>
            </div>}
        </li>}</ul>
    </section>
}
