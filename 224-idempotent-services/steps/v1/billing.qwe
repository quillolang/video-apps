// billing.qwe: the billing service. Other programs call its server fns.
db.open("billing.db")
db.exec("create table if not exists invoices (id integer primary key, name text not null, cents int not null)")

let pause = int(env("BILLING_PAUSE", "0"))   // a slow step after the write

server fn invoice(name: str, cents: int) -> map ! str with db, time {
    if trim(name) == "" { return err("An invoice is for someone") }
    let inv = db.one("insert into invoices (name, cents) values (?, ?) returning id, name, cents", name, cents)
    if pause > 0 { sleep(pause) }
    inv
}

server fn summary() -> map with db {
    let row = db.one("select count(*) as n from invoices")
    { invoices: row.n }
}
