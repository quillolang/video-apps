component List() {
    state list = live(items)
    state item = ""
    state problem = null
    state hide_done = false
    let all = list ?? []
    let left = len(filter(all, (i) => i.done == 0))
    let shown = hide_done ? filter(all, (i) => i.done == 0) : all
    <main>
        <h1>Shopping list</h1>
        <form onsubmit={() => {
            let r = add(item)
            if is_err(r) { problem = r.error } else { item = ""; problem = null }
        }}>
            <input value={item} placeholder="Milk, eggs..." aria-label="New item"/>
            <button>Add</button>
        </form>
        {problem && <p.problem>{problem}</p>}
        <label><input type="checkbox" checked={hide_done}/> Hide done</label>
        <p>{left} left</p>
        <ul>{for i in shown => <li key={i.id}><label>
            <input type="checkbox" checked={i.done == 1} onchange={() => { let _ = toggle(i.id) }}/> {i.name}
        </label></li>}</ul>
    </main>
}
