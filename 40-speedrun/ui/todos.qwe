// <Todos>: the list, in the browser, calling the server fns in lib/todos.qwe.

import lib/todos.qwe use Todo, left, add, toggle, delete_todo, clear_done

// Which to-dos a tab shows.
fn shows(t: Todo, tab: str) -> bool = match tab {
    "active" => t.done == 0,
    "done" => t.done == 1,
    _ => true,
}

component Todos(initial: list<Todo>) {
    state todos = initial
    state draft = ""
    state tab = "all"
    state problem = null

    let send = () => {
        let r = add(draft)
        if is_err(r) { problem = r.error } else { todos = r; draft = ""; problem = null }
    }

    <section.todos>
        <form @submit={send}>
            <input bind:value={draft} placeholder="What needs doing?" autofocus/>
            <button>Add</button>
        </form>
        {problem && <p.problem>{problem}</p>}
        <ul>
            {for t in todos | filter((t) => shows(t, tab)) =>
                <li key={t.id} class={t.done == 1 ? "done" : ""}>
                    <label>
                        <input type="checkbox" checked={t.done == 1} @change={() => { todos = toggle(t.id) }}/>
                        {t.text}
                    </label>
                    <button.x @click={() => { todos = delete_todo(t.id) }}>✕</button>
                </li>}
        </ul>
        <footer>
            <span>{left(todos)} left</span>
            {for name in ["all", "active", "done"] =>
                <button class={name == tab ? "on" : ""} @click={() => { tab = name }}>{name}</button>}
            <button @click={() => { todos = clear_done() }}>Clear done</button>
        </footer>
    </section>
}
